# Public frontend build values
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJ...

# Cloudflare Pages Functions non-secret values
PUBLIC_SITE_URL=https://www.getgridone.com
GRIDONE_SEASON=2026
ENTITLEMENT_BOARD_LIMIT=20
OCR_MODEL=gemini-2.5-flash
STRIPE_2026_PRICE_ID=price_replace_at_launch
PAID_SIGNUP_ENABLED=false
CHECKOUT_SMOKE_CONTEST_IDS=
# Off unless set to the exact string "true"; owner ids are comma-separated UUIDs.
SCORE_TEST_MODE_ENABLED=false
SCORE_TEST_MODE_OWNER_IDS=

# Cloudflare secrets (set in the dashboard or with Wrangler; never commit values)
SUPABASE_SERVICE_ROLE_KEY=replace_me
GEMINI_API_KEY=replace_me
STRIPE_SECRET_KEY=replace_me
STRIPE_WEBHOOK_SECRET=replace_me
CRON_SECRET=replace_me
RETRY_ENDPOINT=https://www.getgridone.com/api/notifications/retry
EMAIL_PROVIDER_API_KEY=replace_me
EMAIL_FROM=GridOne <updates@parksideag.com>
NOTIFICATION_TOKEN_SECRET=replace_with_at_least_32_random_characters
