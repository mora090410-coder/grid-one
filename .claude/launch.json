{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "vite-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 5173
    },
    {
      "name": "api-functions",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["wrangler", "pages", "dev", "--port", "8788"],
      "port": 8788
    },
    {
      "name": "api-smoke",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "wrangler", "pages", "dev", "--port", "8791",
        "--binding", "CRON_SECRET=local-smoke-secret",
        "--binding", "SUPABASE_SERVICE_ROLE_KEY=dummy-service-key",
        "--binding", "LIVE_SCORING_ENABLED=false"
      ],
      "port": 8791
    }
  ]
}
