/p/*
  Referrer-Policy: no-referrer
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow

# Built files carry a content hash in their name, so a returning phone can reuse
# them without asking the server again.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Self-hosted web fonts. Each file name carries the font version and a content
# hash, so it is cached for a year without revalidation. If a font file ever
# changes, give it a new file name (and update src/design/tokens.css and the
# preload links in index.html) — never overwrite a file under an existing name.
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
